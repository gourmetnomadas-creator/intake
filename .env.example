# Dev mode (set to true to skip auth)
NEXT_PUBLIC_DEV_MODE=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Provider: gemini, openai or deepseek.
# Photo analysis needs a provider with vision — gemini and openai have it,
# deepseek does not (meals still analyze, but from the text only).
# Gemini's free tier covers both flash models used here, including image input.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
# DEEPSEEK_API_KEY=your_deepseek_api_key
# OPENAI_API_KEY=your_openai_api_key

# USDA (optional)
USDA_API_KEY=your_usda_api_key
